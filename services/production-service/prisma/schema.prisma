datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["production"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum LotStatus {
  planned
  in_progress
  done

  @@schema("production")
}

enum Priority {
  normal
  urgent

  @@schema("production")
}

enum Severity {
  low
  medium
  high
  critical

  @@schema("production")
}

// ─── Models ──────────────────────────────────────────────────────────────────

model WorkOrder {
  id         String    @id @default(uuid())
  reference  String    @unique
  clientName String
  priority   Priority  @default(normal)
  status     LotStatus @default(planned)
  lots       Lot[]
  createdAt  DateTime  @default(now())
  dueDate    DateTime

  @@schema("production")
}

model Lot {
  id                String     @id @default(uuid())
  reference         String     @unique
  product           String
  quantity          Int
  status            LotStatus  @default(planned)
  startDate         DateTime
  dueDate           DateTime
  machine           String
  completionPercent Float      @default(0)
  workOrder         WorkOrder  @relation(fields: [workOrderId], references: [id])
  workOrderId       String
  materials         Material[]
  incidents         Incident[]

  @@schema("production")
}

model Material {
  id        String @id @default(uuid())
  name      String
  reference String
  quantity  Float
  unit      String
  available Float
  lot       Lot    @relation(fields: [lotId], references: [id])
  lotId     String

  @@schema("production")
}

model Incident {
  id          String    @id @default(uuid())
  severity    Severity
  description String
  reportedAt  DateTime  @default(now())
  reportedBy  String
  resolved    Boolean   @default(false)
  lot         Lot       @relation(fields: [lotId], references: [id])
  lotId       String

  @@schema("production")
}

model HistoryEntry {
  id          String   @id @default(uuid())
  action      String
  target      String
  targetId    String
  performedBy String
  performedAt DateTime @default(now())
  detail      String?

  @@schema("production")
}
